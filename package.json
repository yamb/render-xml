{
  "name": "yamb-render-xml",
  "version": "0.1.1",
  "description": "RSS 2.0 and Atom 1.0 renderers for Yamb post collections",
  "keywords": [
    "atom",
    "blog",
    "feed",
    "renderer",
    "rss",
    "xml",
    "yamb"
  ],
  "license": "MIT",
  "author": {
    "name": "Alexey Simonenko",
    "email": "alexey@simonenko.dev",
    "url": "https://simonenko.xyz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yamb/render-xml.git"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#core": "yamb",
    "#core/*": "yamb/*"
  },
  "exports": {
    ".": "./src/index.js",
    "./errors": "./src/errors/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "node --test --watch 'test/**/*.test.js'"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@meritt/yamb-markdown": "0.1.0",
    "@meritt/yamb-microtypo": "0.1.0",
    "@meritt/yamb-render-html": "0.1.0",
    "@meritt/yamb-render-json": "0.1.0",
    "@xmldom/xmldom": "^0.9.12",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "yamb": "1.0.0"
  },
  "peerDependencies": {
    "yamb": "^1.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "packageManager": "pnpm@12.23.0"
}
